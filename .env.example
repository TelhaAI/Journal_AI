# Copy to .env. All settings are prefixed JOURNAL_.
JOURNAL_DATABASE_URL=sqlite:///./journal.db
# JOURNAL_DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal

# anthropic | openai | scripted | silent
JOURNAL_LLM_PROVIDER=scripted
JOURNAL_LLM_MODEL=claude-sonnet-4-5
# JOURNAL_SAFETY_MODEL=claude-haiku-4-5        # small model for the safety classifier (lexical screen always runs)
# JOURNAL_LOOKBACK_MODEL=

# Provider credentials are read by the SDKs directly:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Fernet key for entries.body / ai_turns.body encryption at rest (recommended before external testers)
# JOURNAL_ENCRYPTION_KEY=

# Required for POST /prompt-versions and activation
JOURNAL_ADMIN_TOKEN=change-me
# Shared code for invited testers on a hosted deployment (the app asks once per browser)
# JOURNAL_TESTER_PASSCODE=

# Tunables (defaults shown)
# JOURNAL_STYLE_HARD_SENTENCE_CAP=8
# JOURNAL_LOOKBACK_DROP_THRESHOLD=0.40
# JOURNAL_WRITE_MIN_WORDS_FOR_RESPONSE=30
# JOURNAL_PRESERVATION_SESSIONS_THRESHOLD=3
# JOURNAL_VOLUME_ROLLOVER_ENTRIES=40
# JOURNAL_SESSION_INACTIVITY_MINUTES=30
